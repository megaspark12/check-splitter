# Application
APP_NAME=Check Splitter
VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-secret-key-here-minimum-32-characters-long
ENVIRONMENT=development  # development, staging, production

# Server
HOST=0.0.0.0
PORT=8000
METRICS_PORT=9090  # Internal metrics port (not exposed to users)
WORKERS=1  # Increase for production (2-4 per CPU core)

# CORS - comma-separated list of allowed origins
# For production, specify exact origins:
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=*

# Database
# SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./check_splitter.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/check_splitter
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Google Gemini AI (Free tier - get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Session settings
SESSION_EXPIRY_MINUTES=15
SESSION_CODE_LENGTH=6

# File uploads
MAX_UPLOAD_SIZE_MB=10
UPLOADS_DIR=uploads

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text
