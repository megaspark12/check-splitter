# ============================================
# Check Splitter — Environment Variables
# ============================================
# Copy to .env and fill in your values:
#   cp .env.example .env

# ====== Required ======

# Google Gemini API key (get at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Secret key for session security (generate: openssl rand -hex 32)
SECRET_KEY=dev-secret-key-change-in-production

# ====== Environment ======

# development | staging | production
ENVIRONMENT=development

# Debug mode (true/false — MUST be false in production)
DEBUG=false

# ====== Server ======

HOST=0.0.0.0
PORT=8000
WORKERS=1

# ====== Database ======

# SQLite (development)
DATABASE_URL=sqlite+aiosqlite:///./check_splitter.db

# PostgreSQL (production) — uncomment and configure:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/check_splitter

# Cloud SQL (auto-constructed if INSTANCE_CONNECTION_NAME is set)
# INSTANCE_CONNECTION_NAME=project:region:instance
# DB_USER=app
# DB_PASS=your-db-password
# DB_NAME=check_splitter

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ====== AI Vision ======

GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# ====== Storage ======

# local (development) | gcs (production)
STORAGE_BACKEND=local
UPLOADS_DIR=uploads

# GCS bucket (required when STORAGE_BACKEND=gcs)
# GCS_BUCKET_NAME=your-bucket-name

# ====== Session ======

SESSION_EXPIRY_MINUTES=15
SESSION_CODE_LENGTH=6
MAX_UPLOAD_SIZE_MB=10

# ====== CORS ======

# Comma-separated origins (* for development)
CORS_ORIGINS=*

# ====== Rate Limiting ======

RATE_LIMIT_PER_MINUTE=180

# ====== Logging ======

LOG_LEVEL=INFO
LOG_FORMAT=text  # json for production, text for development
